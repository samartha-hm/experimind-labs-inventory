{
  "safety-guard": {
    "enabled": true,
    "PreToolUse": [
      {
        "matcher": "run_command",
        "hooks": [
          {
            "type": "command",
            "command": "python scripts/pre_command_guard.py",
            "timeout": 10
          }
        ]
      }
    ]
  },
  "secret-scanner": {
    "enabled": true,
    "PreInvocation": [
      {
        "type": "command",
        "command": "python scripts/scan_credentials.py"
      }
    ]
  }
}
