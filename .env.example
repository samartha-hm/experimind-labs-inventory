# Node Server Environment Configuration
# Tenant UUID serving the public shop and receiving storefront orders
STOREFRONT_ORG_ID=
NODE_ENV=development
PORT=3000
APP_URL=http://localhost:3000
PUBLIC_ERP_URL=http://localhost:3000
PUBLIC_SHOP_URL=http://localhost:3001
# Deployment target hostname for PowerShell deploy/rollback
EC2_HOST=
# Configure in the storefront build environment to enable UPI links
NEXT_PUBLIC_UPI_PAYEE_ADDRESS=

# PostgreSQL Database Connection String
DATABASE_URL=postgres://postgres:postgres@localhost:5432/experimind_inventory

# Secret Key for JWT Signing (Must be at least 32 characters in production)
JWT_SECRET=super-secret-jwt-key-experimind-labs-inventory-2026-secure

# Google Gemini AI API Key
GEMINI_API_KEY=your_gemini_api_key_here

# Environment-Gated Guest Mode (STRICTLY FALSE IN PRODUCTION)
ALLOW_GUEST=false
GUEST_ROLE=viewer
