# Node Server Environment Configuration
NODE_ENV=development
PORT=3000
APP_URL=http://localhost:3000

# PostgreSQL Database Connection String
DATABASE_URL=postgres://postgres:postgres@localhost:5432/experimind_inventory

# Secret Key for JWT Signing (Must be at least 32 characters in production)
JWT_SECRET=super-secret-jwt-key-experimind-labs-inventory-2026-secure

# Google Gemini AI API Key
GEMINI_API_KEY=your_gemini_api_key_here

# Environment-Gated Guest Mode (STRICTLY FALSE IN PRODUCTION)
ALLOW_GUEST=false
GUEST_ROLE=viewer
